# Copy to .env.local (gitignored) and fill in. Hosting (e.g. Vercel): add the same vars in project settings.

# --- Resume (lib/resume/source.ts) ---
# Private repo holding resume.tex, as owner/name.
RESUME_GITHUB_REPO=jon-cheng7/REPO_NAME
# Fine-grained token: github.com/settings/personal-access-tokens/new
#   Repository access: Only select repositories → the resume repo
#   Permissions → Repository → Contents: Read-only (nothing else)
RESUME_GITHUB_TOKEN=
# File path inside the repo, and branch/tag (empty = default branch).
RESUME_PATH=resume.tex
RESUME_REF=
# Any long random string. Same value goes in the resume repo's Action secret SITE_REVALIDATE_SECRET.
RESUME_REVALIDATE_SECRET=
# Optional: read a local file instead of GitHub (preview unpublished edits).
# RESUME_LOCAL_PATH=../resume/resume.tex

# --- Photos (scripts/photos, content/photos.ts) ---
# Folder of full-size JPEG exports (source of truth). Use forward slashes on Windows.
PHOTOS_MASTERS_DIR=C:/Users/Jonat/Pictures/website-photos
# local = public/photos-cdn (dev preview) · r2 = Cloudflare R2 (real site)
PHOTOS_TARGET=local
# Where the site loads images from. Dev: /photos-cdn · real site: https://img.joncheng.ca
NEXT_PUBLIC_PHOTOS_URL=/photos-cdn
# Cloudflare dash → R2 → Manage API tokens (Object Read & Write, this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=joncheng-photos
