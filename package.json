    "next": "^16.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "d3-geo": "3.1.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "exifr": "7.1.3",
    "sharp": "0.35.5",
    "typescript": "^5"
  }
