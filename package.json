{
  "name": "personal-website",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "resume:check": "node --env-file=.env.local scripts/check-resume.mjs",
    "resume:save": "node --env-file=.env.local scripts/check-resume.mjs --save",
