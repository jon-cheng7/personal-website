    "photos:dry": "node --env-file=.env.local scripts/photos/sync.mjs --dry",
    "geo": "node scripts/geo/build-geo.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.0",
    "geist": "1.7.2",
    "gsap": "^3.12.0",
